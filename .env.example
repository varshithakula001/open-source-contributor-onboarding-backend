# =============================================================================
# Open Source Contributor Onboarding - Backend Environment Configuration
# =============================================================================
# Copy this file to '.env' and fill in values for your local environment:
#   copy .env.example .env (Windows Powershell / CMD)
# NOTE: Never commit your actual '.env' file to Git!
# =============================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# Frontend Client Origin (Allowed by CORS)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection
# Format:MONGODB_URI=mongodb://127.0.0.1:27017/open_source_contributor_onboarding
# In development mode, leaving this empty will allow the server to start with database status as 'unconfigured'.
# In production mode, this is strictly required.
MONGODB_URI=

# Authentication & Server-Side Session Management (Phase 3)
# SESSION_SECRET must be at least 32 characters in length.
# Generate a secure random key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_MS=604800000
BCRYPT_SALT_ROUNDS=12

# Development-Only Helper:
# Set to 'true' to display email verification and password reset links in local development terminal.
# Never enable or expose in production!
DEV_AUTH_TOKEN_LOGGING=true

# -----------------------------------------------------------------------------
# Phase 5: Local Ollama AI & MongoDB Atlas Vector Search Settings
# -----------------------------------------------------------------------------
# Base URL for local Ollama service (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Local LLM model for grounded RAG answer generation (default: llama3.2)
OLLAMA_LLM_MODEL=llama3.2

# Local embedding model generating 768-dimensional vectors (default: nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Atlas Vector Search index name defined on the 'chunks' collection (default: vector_index)
ATLAS_VECTOR_INDEX_NAME=vector_index

# Atlas Vector Search index name defined on the 'issues' collection (Phase 6, default: issue_vector_index)
ATLAS_ISSUE_VECTOR_INDEX_NAME=issue_vector_index

# Embedding dimension expected from nomic-embed-text (default: 768)
EMBEDDING_DIMENSIONS=768
